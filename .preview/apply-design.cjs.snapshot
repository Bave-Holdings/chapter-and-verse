const fs = require('node:fs');
function edit(file, transform) { fs.writeFileSync(file, transform(fs.readFileSync(file, 'utf8'))); }

edit('app/_components/product-preview.tsx', source => {
  const wave = source.slice(source.indexOf('function WavePattern'), source.indexOf('export function ProductPreview'));
  return `import Image from "next/image";\nimport styles from "../page.module.css";\n\n${wave}export function ProductPreview() {
  return <aside className={styles.visualPanel} aria-hidden="true">
    <WavePattern className={styles.dotPatternTop} />
    <WavePattern className={styles.dotPatternLeft} />
    <WavePattern className={styles.dotPatternBottom} />
    <div className={styles.productPreview}>
      <Image src="/product-preview.webp" alt="" width={770} height={752}
        sizes="(max-width: 900px) 0px, 52vw" className={styles.previewImage} />
    </div>
  </aside>;
}\n`;
});

edit('app/page.module.css', source => {
  source = source.replace('minmax(500px, 42%)', 'minmax(440px, 42%)');
  source = source.replace(/  background:\r?\n    radial-gradient\(circle at 8%[\s\S]*?rgba\(61, 213, 192, 0.05\);/, '  background: radial-gradient(ellipse at 0 12%, #fff9, transparent 55%), #f7f8fa;');
  source = source.replace('width: 248px;', 'width: 232px;');
  source = source.replace('.forgotContent .intro { margin-top: 128px; }', '.forgotContent .intro { margin-top: 96px; }');
  const start = source.indexOf('.productPreview {');
  const end = source.indexOf('@keyframes contentRise');
  source = source.slice(0, start) + `.productPreview {
  position: absolute;
  top: 11.5%;
  bottom: 11.5%;
  left: 12%;
  width: 88%;
  overflow: hidden;
  border-radius: 24px 0 0 24px;
  box-shadow: 0 8px 30px rgba(2, 13, 25, 0.3);
}
.previewImage { display: block; width: 100%; height: 100%; object-fit: cover; object-position: left top; }

` + source.slice(end);
  // Remove animation rules for the previous upload-card illustration.
  const keyframesStart = source.indexOf('@keyframes previewReveal');
  const mediaStart = source.indexOf('@media (max-width: 900px)');
  source = source.slice(0, keyframesStart) + source.slice(mediaStart);
  source = source.replace(/@media \(prefers-reduced-motion: reduce\)[\s\S]*$/, `@media (prefers-reduced-motion: reduce) {
  .logo, .intro, .form, .loginPrompt, .backLink { animation: none; }
  .field input, .submit { transition: none; }
}\n`);
  source = source.replace('background: radial-gradient(circle at 4% 7%, rgba(61, 213, 192, 0.18), transparent 31%), radial-gradient(circle at 100% 100%, rgba(61, 213, 192, 0.12), transparent 27%), rgba(61, 213, 192, 0.025);', 'background: radial-gradient(ellipse at 5% 10%, #ecfcf8, transparent 50%), #f7f8fa;');
  return source;
});
